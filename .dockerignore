# Ignore the Dockerfile and docker-compose files
Dockerfile
docker-compose.yml

# Ignore the README file
README.md

# Ignore the vendor directory if using Composer
vendor/

# Ignore local node_modules — npm ci reinstalls inside the image, and root/frontend both
# have their own package-lock.json (Playwright tooling vs. the Vue SPA build)
node_modules/
frontend/node_modules/

# Ignore a locally-built SPA — the Dockerfile builds its own copy in-image
public/dist/

# Ignore any log files
*.log

# Ignore temporary files
*.tmp
*.temp

# Ignore system files
.DS_Store
Thumbs.db

# Ignore IDE specific files
.idea/
.vscode/